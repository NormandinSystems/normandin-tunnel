{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Normandin Tunnel",
  "mainBinaryName": "normandin-tunnel",
  "version": "0.1.0",
  "identifier": "com.normandinsystems.tunnel",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Normandin Tunnel",
        "width": 1040,
        "height": 720,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Normandin Systems",
    "category": "Utility",
    "shortDescription": "Send files between your devices with a one-time code.",
    "longDescription": "Normandin Tunnel links two devices with a short one-time code and an end-to-end encrypted connection, then lets either side send files, folders and text of any size. No accounts, nothing stored on a server.",
    "copyright": "Copyright (c) 2026 Normandin Systems",
    "linux": {
      "deb": { "depends": [] },
      "rpm": { "depends": [] }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "languages": ["English", "French"] }
    }
  }
}
