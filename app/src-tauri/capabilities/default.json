{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Everything the main window may do. Nothing else is reachable from the web view.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "clipboard-manager:allow-write-text",
    "allow-get-state",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-history",
    "allow-clear-history",
    "allow-app-info",
    "allow-complete-word",
    "allow-check-code",
    "allow-create-code",
    "allow-join-code",
    "allow-confirm-safety",
    "allow-send-paths",
    "allow-send-text",
    "allow-respond-offer",
    "allow-pause-transfer",
    "allow-resume-transfer",
    "allow-cancel-transfer",
    "allow-end-session",
    "allow-dismiss-session",
    "allow-open-folder"
  ]
}
